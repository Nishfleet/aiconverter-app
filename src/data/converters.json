{
  "converters": [
    {
      "id": "bank",
      "title": "Bank statement",
      "input": "PDF",
      "output": "CSV",
      "state": "Live",
      "accept": "application/pdf,.pdf",
      "description": "Preview and extract dates, descriptions, money in, money out, and balances from bank statement PDFs.",
      "columns": [
        { "key": "date", "label": "Date" },
        { "key": "description", "label": "Description" },
        { "key": "money_in", "label": "In" },
        { "key": "money_out", "label": "Out" },
        { "key": "balance", "label": "Balance" }
      ],
      "checks": ["Row extraction", "Date normalization", "Balance checks"]
    },
    {
      "id": "receipt",
      "title": "Receipt",
      "input": "Image / PDF",
      "output": "Expense CSV",
      "state": "Beta",
      "accept": "application/pdf,image/png,image/jpeg,image/webp,.pdf,.png,.jpg,.jpeg,.webp",
      "description": "Extract vendor, date, category, total, tax, payment method, and notes from receipt images or PDFs.",
      "columns": [
        { "key": "date", "label": "Date" },
        { "key": "vendor", "label": "Vendor" },
        { "key": "category", "label": "Category" },
        { "key": "total", "label": "Total" },
        { "key": "currency", "label": "Currency" },
        { "key": "subtotal", "label": "Subtotal" },
        { "key": "tax", "label": "Tax" },
        { "key": "payment_method", "label": "Payment method" },
        { "key": "notes", "label": "Notes" }
      ],
      "checks": ["Vendor detection", "Tax and total checks", "Category inference"]
    },
    {
      "id": "screenshot",
      "title": "Screenshot",
      "input": "PNG / JPG",
      "output": "Spreadsheet",
      "state": "Beta",
      "accept": "application/pdf,image/png,image/jpeg,image/webp,.pdf,.png,.jpg,.jpeg,.webp",
      "description": "Pull table-like data from screenshots and image PDFs into spreadsheet-ready CSV.",
      "columns": [
        { "key": "column_1", "label": "Column 1" },
        { "key": "column_2", "label": "Column 2" },
        { "key": "column_3", "label": "Column 3" },
        { "key": "column_4", "label": "Column 4" },
        { "key": "column_5", "label": "Column 5" }
      ],
      "checks": ["Table OCR", "Header inference", "Spreadsheet CSV"]
    },
    {
      "id": "invoice",
      "title": "Invoice / bill",
      "input": "Image / PDF",
      "output": "Structured file",
      "state": "Beta",
      "accept": "application/pdf,image/png,image/jpeg,image/webp,.pdf,.png,.jpg,.jpeg,.webp",
      "description": "Extract vendor, invoice number, dates, totals, tax, payment terms, notes, and line items from invoices or bills.",
      "outputFormats": [
        { "id": "csv", "label": "CSV" },
        { "id": "json", "label": "JSON" }
      ],
      "columns": [
        { "key": "vendor", "label": "Vendor" },
        { "key": "invoice_number", "label": "Invoice #" },
        { "key": "invoice_date", "label": "Invoice date" },
        { "key": "due_date", "label": "Due date" },
        { "key": "total", "label": "Total" },
        { "key": "currency", "label": "Currency" },
        { "key": "tax", "label": "Tax" },
        { "key": "payment_terms", "label": "Payment terms" },
        { "key": "notes", "label": "Notes" }
      ],
      "checks": ["Invoice fields", "Total checks", "Line-item capture"]
    },
    {
      "id": "image-format",
      "title": "Image format",
      "input": "PNG / JPG / WEBP",
      "output": "PNG / JPG / WEBP",
      "state": "Local",
      "mode": "local-image",
      "accept": "image/png,image/jpeg,image/webp,.png,.jpg,.jpeg,.webp",
      "description": "Convert common image formats inside the browser. The file does not upload to AI Converter.",
      "outputFormats": [
        { "id": "png", "label": "PNG" },
        { "id": "jpeg", "label": "JPG" },
        { "id": "webp", "label": "WEBP" }
      ],
      "checks": ["Browser-local", "No server upload", "Instant download"]
    },
    {
      "id": "raster-vector",
      "title": "Raster to SVG",
      "input": "PNG / JPG / WEBP",
      "output": "SVG",
      "state": "Local",
      "mode": "local-svg",
      "accept": "image/png,image/jpeg,image/webp,.png,.jpg,.jpeg,.webp",
      "description": "Create a lightweight posterized SVG from a common image inside the browser. The file does not upload to AI Converter.",
      "outputFormats": [
        { "id": "svg", "label": "SVG" }
      ],
      "checks": ["Browser-local", "No server upload", "SVG download"]
    },
    {
      "id": "audio-transcript",
      "title": "Audio transcript",
      "input": "MP3 / WAV / M4A",
      "output": "Transcript",
      "state": "Beta",
      "accept": "audio/mpeg,audio/mp3,audio/wav,audio/wave,audio/x-wav,audio/mp4,audio/x-m4a,audio/aac,audio/ogg,audio/webm,.mp3,.wav,.m4a,.aac,.ogg,.webm",
      "description": "Transcribe common audio files into a TXT transcript or structured JSON using Workers AI speech recognition.",
      "outputFormats": [
        { "id": "txt", "label": "TXT" },
        { "id": "json", "label": "JSON" }
      ],
      "columns": [
        { "key": "transcript", "label": "Transcript" },
        { "key": "word_count", "label": "Words" },
        { "key": "format", "label": "Format" }
      ],
      "checks": ["Speech-to-text", "TXT or JSON", "25 MB audio limit"]
    },
    {
      "id": "document-markdown",
      "title": "Document Markdown",
      "input": "PDF / DOCX / XLSX / HTML",
      "output": "Markdown",
      "state": "Beta",
      "accept": "application/pdf,image/png,image/jpeg,image/webp,image/svg+xml,text/html,application/xml,text/xml,text/csv,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/vnd.ms-excel,application/vnd.ms-excel.sheet.macroenabled.12,application/vnd.ms-excel.sheet.binary.macroenabled.12,application/vnd.oasis.opendocument.spreadsheet,application/vnd.oasis.opendocument.text,application/vnd.apple.numbers,.pdf,.png,.jpg,.jpeg,.webp,.svg,.html,.htm,.xml,.csv,.docx,.xlsx,.xlsm,.xlsb,.xls,.et,.ods,.odt,.numbers",
      "description": "Convert rich documents and images into clean Markdown using Cloudflare Markdown Conversion.",
      "outputFormats": [
        { "id": "md", "label": "MD" }
      ],
      "columns": [
        { "key": "name", "label": "File" },
        { "key": "type", "label": "Type" },
        { "key": "tokens", "label": "Tokens" },
        { "key": "preview", "label": "Preview" }
      ],
      "checks": ["Document to Markdown", "Rich-format parser", "Private download"]
    },
    {
      "id": "screenshot-code",
      "title": "Screenshot to HTML",
      "input": "PNG / JPG / WEBP / PDF",
      "output": "HTML starter",
      "state": "Beta",
      "accept": "application/pdf,image/png,image/jpeg,image/webp,.pdf,.png,.jpg,.jpeg,.webp",
      "description": "Turn readable screenshot content into a clean HTML starter. This is not a pixel-perfect clone.",
      "outputFormats": [
        { "id": "html", "label": "HTML" }
      ],
      "columns": [
        { "key": "component", "label": "Component" },
        { "key": "source", "label": "Source" },
        { "key": "preview", "label": "Preview" }
      ],
      "checks": ["Screenshot to Markdown", "HTML starter", "Truthful non-pixel-perfect output"]
    },
    {
      "id": "email",
      "title": "Email monitor",
      "input": "Inbox",
      "output": "Converted files",
      "state": "Upcoming",
      "description": "Let AI watch a connected inbox for converter requests once the direct upload workflow is proven."
    }
